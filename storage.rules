rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de produtos: leitura pública (vitrine da loja), escrita só de admin.
    // O Firestore guarda apenas a URL https (coleção "products").
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'rickyjorgecastro@gmail.com' ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'rickyjorgecastro@gmail.com')
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
